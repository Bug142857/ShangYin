<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义播放器控制条（PlayerView.setControllerLayoutId 使用）：
     保留 media3 的 播放/暂停 + 时间 + 进度条，去掉上一集/下一集/快退/快进按钮，
     设置齿轮（倍速菜单）移除避免出现"立体声"音轨项，倍速改由 Compose 悬浮按钮提供；
     右下角加自定义"选集"按钮（id btn_episode，代码里绑定点击）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/vod_controller_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageButton
            android:id="@id/exo_play"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="播放"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vod_play"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@id/exo_pause"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="暂停"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vod_pause"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        app:buffered_color="#55FFFFFF"
        app:played_color="#FFFFFF"
        app:scrubber_color="#FFFFFF"
        app:scrubber_dragged_size="16dp"
        app:scrubber_enabled_size="11dp"
        app:unplayed_color="#33FFFFFF" />

    <TextView
        android:id="@id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:includeFontPadding="false"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_episode"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="选集"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/btn_speed_anchor"
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageButton
            android:id="@+id/btn_speed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="倍速"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_speed"
            android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
